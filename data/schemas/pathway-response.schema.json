{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/contrivancecompanychicago/replicatedgenecrispy2dpatientworld/blob/main/data/schemas/pathway-response.schema.json","title":"GENE CRISpy pathway response","description":"JSON response returned by GET /genecrispy/pathways/{pathway_id}. KGML relations connect pathway entry IDs; endpoints may refer to genes, compounds, or other pathway entries.","type":"object","additionalProperties":false,"required":["pathway_id","title","organism","entries","gene_count","compound_count","relations","relation_count","safety_notice"],"properties":{"pathway_id":{"type":"string","pattern":"^hsa[0-9]{5}$"},"title":{"type":"string","minLength":1},"organism":{"type":"string"},"entries":{"type":"array","items":{"$ref":"#/$defs/entry"}},"gene_count":{"type":"integer","minimum":0},"compound_count":{"type":"integer","minimum":0},"relations":{"type":"array","items":{"$ref":"#/$defs/relation"}},"relation_count":{"type":"integer","minimum":0},"safety_notice":{"type":"string","minLength":1}},"$defs":{"entry":{"type":"object","additionalProperties":false,"required":["id","name","type"],"properties":{"id":{"type":"string","minLength":1},"name":{"type":"string"},"type":{"type":"string","enum":["gene","compound","map","group","ortholog","enzyme","other"]},"label":{"type":"string"},"x":{"type":"integer"},"y":{"type":"integer"},"width":{"type":"integer","minimum":0},"height":{"type":"integer","minimum":0}}},"relation":{"type":"object","additionalProperties":false,"required":["entry1","entry2","type","subtypes"],"properties":{"entry1":{"type":"string","minLength":1,"description":"KGML source pathway-entry ID; resolve against entries[].id."},"entry2":{"type":"string","minLength":1,"description":"KGML target pathway-entry ID; resolve against entries[].id."},"type":{"type":"string","enum":["PPrel","GErel","PCrel","ECrel","maplink","other"]},"subtypes":{"type":"array","items":{"$ref":"#/$defs/subtype"}}}},"subtype":{"type":"object","additionalProperties":false,"required":["name","value"],"properties":{"name":{"type":"string"},"value":{"type":"string"}}}}}